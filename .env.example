# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Sincronização de produtos (Protheus / SQL Server) — somente leitura
# Desktop instalado: salve este cadastro em %APPDATA%\react-example\config\.env.
# A atualização preserva esse arquivo; o instalador público não contém senhas.
# Desenvolvimento: .env na raiz do projeto. PDV_ENV_FILE permite um caminho explícito.
MSSQL_SERVER=10.0.0.1
MSSQL_DATABASE=PROTHEUS11
MSSQL_USER=usuario_readonly
MSSQL_PASSWORD=troque-me
MSSQL_PORT=1433
# MSSQL_ENCRYPT=false
# MSSQL_TRUST_SERVER_CERTIFICATE=true

# Conta principal REST: consultas e envio das vendas. Sem vínculo SA3/A3_CODUSR na filial 01.
# Operadores usam somente login/senha PDV e seu vínculo usuário/vendedor; não informam senha REST.
PROTHEUS_REST_URL=http://seu-servidor:9990/rest
# Esta base é usada por todas as consultas 4Sales e por /4SALFORTFRUITORDERS.
# A mudança de ambiente exige reiniciar o PDV e renovar o SQLite local.
PROTHEUS_REST_USER=troque-me
# Se o valor começar com # ou outro caractere especial, coloque entre aspas — senão o dotenv trata
# como comentário e a senha chega vazia.
PROTHEUS_REST_PASSWORD=troque-me
PROTHEUS_REST_ENDPOINT_PEDIDO=PDVFORTFRUIT/pedido
PROTHEUS_COND_PAGAMENTO_PADRAO=
PROTHEUS_TABELA_PRECO_PADRAO=015
# Contexto explícito; deve coincidir com o ambiente preparado pelo REST.
PROTHEUS_PDV_EMPRESA=
PROTHEUS_PDV_FILIAL=
PROTHEUS_PDV_ARMAZEM=

# Legado: chave das senhas individuais antigas, que não são mais utilizadas pela integração.
# Preserve a chave existente para manter a possibilidade de recuperar o cadastro legado.
PROTHEUS_CRED_SECRET=troque-me-por-um-valor-aleatorio-longo

# Nome exato da impressora térmica tal como aparece em "Dispositivos e Impressoras" do Windows
# (ver server/impressora-termica.js) — usado pra mandar o cupom em ESC/POS via RAW print.
IMPRESSORA_NOME=EPSON TM-T20III Receipt
